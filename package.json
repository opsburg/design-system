{
    "name": "@opsburg/design-system",
    "version": "0.1.0",
    "description": "Design System for Opsburg",
    "license": "Apache-2.0",
    "type": "module",
    "packageManager": "pnpm@10.19.0",
    "engines": {
        "node": ">=21.0.0"
    },
    "files": [
        "dist"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./theme.css": "./dist/theme.css",
        "./tokens.json": "./dist/tokens.json",
        "./fonts/*": "./dist/fonts/*",
        "./package.json": "./package.json"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/opsburg/design-system.git"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "typecheck": "tsc --noEmit",
        "lint": "biome lint --write ./src",
        "format": "biome format --write ./src",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build -o storybook-static",
        "test:a11y": "node scripts/a11y.mjs"
    },
    "dependencies": {
        "@radix-ui/react-accordion": "^1.3.1",
        "@radix-ui/react-avatar": "^1.3.1",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-popover": "^1.3.1",
        "@radix-ui/react-radio-group": "^1.5.1",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-slider": "^1.6.1",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-switch": "^1.4.1",
        "@radix-ui/react-tabs": "^1.2.1",
        "@radix-ui/react-toggle": "^1.2.1",
        "@radix-ui/react-toggle-group": "^1.2.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "lucide-react": "^1.74.0",
        "react-day-picker": "^10.0.2",
        "react-pick-color": "^2.1.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss-animate": "1.0.7"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0",
        "react-hook-form": "^7.0.0",
        "tailwindcss": "^4.0.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@biomejs/biome": "^2.6.8",
        "@storybook/addon-a11y": "10.6.7",
        "@storybook/addon-docs": "10.6.7",
        "@storybook/react-vite": "10.6.7",
        "@tailwindcss/vite": "4.3.5",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript/typescript6": "^6.0.2",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "playwright": "1.65.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.92.0",
        "storybook": "10.6.7",
        "tailwindcss": "4.3.5",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vite-plugin-dts": "^5.1.2"
    }
}
